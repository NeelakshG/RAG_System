# Copy to .env and fill in. Every field of config.Config can be set here
# with a RAG_ prefix (e.g. RAG_FINAL_K=3). .env is gitignored -- never commit it.

# Required for any deployment other people can reach. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave unset only for local dev (write endpoints are then unauthenticated).
RAG_API_KEY=

RAG_STRATEGY=recursive
RAG_OLLAMA_HOST=http://localhost:11434
RAG_LLM_MODEL=llama3.1
RAG_OLLAMA_TIMEOUT_S=60
RAG_OLLAMA_RETRIES=2

RAG_DATA_DIR=data
RAG_CORPUS_DIR=data/corpus
RAG_MAX_UPLOAD_MB=10

# LLM provider: "ollama" (local, default) or "groq" (hosted free tier, used
# by the public demo). With groq, get a key at https://console.groq.com/keys
# -- and never add a payment method to that account, so it can't bill.
RAG_LLM_PROVIDER=ollama
RAG_GROQ_API_KEY=
RAG_GROQ_MODEL=openai/gpt-oss-20b
